# Copy to .env.local and fill in real values
# cp .env.local.example .env.local

# FastAPI ML Backend URL (server-side rewrite)
FASTAPI_URL=http://localhost:8000

# Public base URL of this Next.js app
NEXT_PUBLIC_API_URL=http://localhost:3000

# JWT Secret — generate with: openssl rand -base64 32
# Minimum 32 characters required
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars

# JWT expiry in seconds (default: 8 hours = 28800)
JWT_EXPIRY=28800

# Demo accounts password (all 4 demo users share this password)
# Accounts: auditeur@pwc.com | manager@pwc.com | partner@pwc.com | admin@pwc.com
# Remove this variable in production and use real bcrypt-hashed passwords in PostgreSQL
DEMO_PASSWORD=pwc2024
