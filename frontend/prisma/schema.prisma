// Prisma schema — PwC Audit Analytics Platform
// PostgreSQL backend for all business entities

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  auditor
  manager
  partner
  admin
}

enum UserStatus {
  active
  inactive
  suspended
}

enum MissionStatus {
  active
  in_progress
  completed
  archived
}

enum MissionType {
  financial_audit
  fraud_detection
  compliance_review
  risk_assessment
  internal_audit
}

enum DatasetCategory {
  transactions
  general_ledger
  trial_balance
}

enum DatasetStatus {
  pending
  uploaded
  analyzing
  analyzed
  error
}

enum AnalysisStatus {
  running
  completed
  failed
}

enum RiskLevel {
  CRITIQUE
  ELEVE
  FAIBLE
}

enum AuditAction {
  login
  logout
  mission_create
  mission_update
  mission_delete
  mission_assign
  dataset_upload
  dataset_delete
  dataset_replace
  analysis_start
  analysis_complete
  report_generate
  report_download
  anomaly_comment
  anomaly_status_change
  user_create
  user_update
  user_deactivate
  role_modify
}

// ─── Core Tables ──────────────────────────────────────────────────────────────

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  name       String
  role       UserRole
  status     UserStatus @default(active)
  phone      String?
  position   String?
  department String?
  password   String
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  // Relations
  createdMissions    Mission[]       @relation("MissionCreator")
  assignedMissions   Mission[]       @relation("MissionAssignee")
  missionAssignments MissionAssignment[]
  datasets           Dataset[]
  analysisRuns       AnalysisRun[]
  auditLogs          AuditLog[]
  anomalyComments    AnomalyComment[]
  reports            Report[]

  @@map("users")
}

model Permission {
  id          String   @id @default(uuid())
  role        UserRole @unique
  permissions Json
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("permissions")
}

model Mission {
  id          String        @id @default(uuid())
  name        String
  companyName String        @map("company_name")
  missionType MissionType   @map("mission_type")
  description String?
  status      MissionStatus @default(active)
  startDate   String        @map("start_date")
  endDate     String?       @map("end_date")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // FK relations
  createdById  String @map("created_by_id")
  createdBy    User   @relation("MissionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId String? @map("assigned_to_id")
  assignedTo   User?   @relation("MissionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Child relations
  assignments  MissionAssignment[]
  datasets     Dataset[]
  analysisRuns AnalysisRun[]
  auditLogs    AuditLog[]
  reports      Report[]

  @@map("missions")
}

model MissionAssignment {
  id         String   @id @default(uuid())
  missionId  String   @map("mission_id")
  userId     String   @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([missionId, userId])
  @@map("mission_assignments")
}

model Dataset {
  id           String          @id @default(uuid())
  missionId    String          @map("mission_id")
  uploadedById String          @map("uploaded_by_id")
  name         String
  originalName String          @map("original_name")
  category     DatasetCategory @default(transactions)
  status       DatasetStatus   @default(uploaded)
  rowCount     Int?            @map("row_count")
  columnCount  Int?            @map("column_count")
  fileSizeBytes BigInt?        @map("file_size_bytes")
  storagePath  String?         @map("storage_path")
  uploadedAt   DateTime        @default(now()) @map("uploaded_at")
  deletedAt    DateTime?       @map("deleted_at")

  mission    Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  versions     DatasetVersion[]
  analysisRuns AnalysisRun[]

  @@map("datasets")
}

model DatasetVersion {
  id          String   @id @default(uuid())
  datasetId   String   @map("dataset_id")
  version     Int      @default(1)
  storagePath String   @map("storage_path")
  rowCount    Int?     @map("row_count")
  createdAt   DateTime @default(now()) @map("created_at")

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, version])
  @@map("dataset_versions")
}

model AnalysisRun {
  id          String         @id @default(uuid())
  missionId   String         @map("mission_id")
  datasetId   String         @map("dataset_id")
  runById     String         @map("run_by_id")
  missionName String         @map("mission_name")
  datasetName String         @map("dataset_name")
  model       String
  status      AnalysisStatus @default(running)
  result      Json?
  startedAt   DateTime       @default(now()) @map("started_at")
  completedAt DateTime?      @map("completed_at")

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  runBy   User    @relation(fields: [runById], references: [id], onDelete: Restrict)

  anomalies Anomaly[]

  @@map("analysis_runs")
}

model Anomaly {
  id           String    @id @default(uuid())
  analysisRunId String   @map("analysis_run_id")
  transactionId String   @map("transaction_id")
  riskLevel    RiskLevel @map("risk_level")
  fraudScore   Float     @map("fraud_score")
  amount       Float?
  features     Json?
  explanation  String?
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  analysisRun AnalysisRun      @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  comments    AnomalyComment[]

  @@map("anomalies")
}

model AnomalyComment {
  id        String   @id @default(uuid())
  anomalyId String   @map("anomaly_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  anomaly Anomaly @relation(fields: [anomalyId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@map("anomaly_comments")
}

model Report {
  id          String   @id @default(uuid())
  missionId   String   @map("mission_id")
  generatedById String @map("generated_by_id")
  format      String
  fileName    String   @map("file_name")
  storagePath String?  @map("storage_path")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  mission     Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  generatedBy User    @relation(fields: [generatedById], references: [id], onDelete: Restrict)

  @@map("reports")
}

model AuditLog {
  id          String      @id @default(uuid())
  action      AuditAction
  userId      String      @map("user_id")
  userName    String      @map("user_name")
  userRole    UserRole    @map("user_role")
  missionId   String?     @map("mission_id")
  missionName String?     @map("mission_name")
  details     String
  metadata    Json?
  timestamp   DateTime    @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([missionId])
  @@index([action])
  @@index([timestamp(sort: Desc)])
  @@map("audit_logs")
}
